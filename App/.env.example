# Base de datos PostgreSQL
# Opción 1: DATABASE_URL para servicios en la nube como Neon, Supabase, Render, etc.
# DATABASE_URL=postgresql://usuario:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Opción 2: Parámetros individuales (utilizado si DATABASE_URL no está definido)
DB_HOST=nombre_contenedor_db
DB_PORT=5432
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=db_name

# Administrador
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Número de WhatsApp del restaurante (código país + número)
WHATSAPP_NUMBER=123456789

# Versión de la aplicación
APP_VERSION=v6.0.1